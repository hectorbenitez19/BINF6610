rule filter:
    input: work/joint/cohort.raw.vcf.gz, work/joint/cohort.raw.vcf.gz.tbi
    output: results/cohort.filtered.vcf.gz, results/cohort.filtered.vcf.gz.tbi, results/variants.tsv
    log: logs/filter.log
    jobid: 1
    reason: Missing output files: results/cohort.filtered.vcf.gz, results/cohort.filtered.vcf.gz.tbi, results/variants.tsv; Input files updated by another job: work/joint/cohort.raw.vcf.gz, work/joint/cohort.raw.vcf.gz.tbi
    threads: 2
    resources: tmpdir=<TBD>, mem_mb=8000, mem=8 GB, mem_mib=7630, disk_mb=1000, disk=1 GB, disk_mib=954, slurm_account=binf6610.202710, slurm_partition=courses, runtime=60
Shell command: 
        gatk VariantFiltration \
            -V work/joint/cohort.raw.vcf.gz \
            -O results/cohort.filtered.vcf.gz \
            --filter-name "LowQD" \
            --filter-expression "QD < 2.0" \
            --filter-name "HighFS" \
            --filter-expression "FS > 60.0" \
            --filter-name "LowMQ" \
            --filter-expression "MQ < 40.0" \
            > logs/filter.log 2>&1

   bcftools index -t -f results/cohort.filtered.vcf.gz 2>> logs/filter.log

        printf 'chrom\tpos\tref\talt\tqual\tfilter\n' > results/variants.tsv

        bcftools query \
            -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\n' \
            results/cohort.filtered.vcf.gz >> results/variants.tsv 2>> logs/filter.log
        
