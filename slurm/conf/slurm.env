# Everything cluster-specific lives here, so the sbatch scripts contain no paths
# and the pipeline contains no Slurm. Change machine, change this file.

PARTITION=courses
ACCOUNT=binf6610.202710

# --export=NONE means almost nothing is inherited, so do not assume $USER.
USER=${USER:-$(id -un)}

# Where this run writes. /scratch is the large filesystem and is wiped on the
# first Tuesday of every month, which is the right place for BAMs and trimmed
# fastq. Anything that has to outlive that goes to the course directory.
RUN_ROOT=/scratch/${USER}/w2-demo
KEEP_DIR=/courses/BINF6610.202710/staff/${USER}/w2-demo

# The cohort samplesheet as shipped. Twelve columns; the pipeline reads the six
# it needs by name.
SHEET=/courses/BINF6610.202710/data/samplesheet-demo12.csv
FASTQ_ROOT=/courses/BINF6610.202710/data

PIPELINE_DIR=${HOME}/w2-demo-pipeline
CONDA_ENV=/courses/BINF6610.202710/shared/env/binf6610

REF_DIR=/courses/BINF6610.202710/data/refs/grch38
